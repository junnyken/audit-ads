# ---- Application -----------------------------------------------------------
APP_NAME="AdsOps Control Center"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://adsops:change-me@db:5432/adsops
POSTGRES_USER=adsops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adsops

# ---- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS ------------------------------------------------------------------
# Comma-separated allowlist. No wildcard.
CORS_ORIGINS=http://localhost:5173

# ---- First-run owner -------------------------------------------------------
# Used once, only while the database has no workspace.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_WORKSPACE_NAME=AdsOps

# ---- Readiness policy ------------------------------------------------------
READINESS_MANUAL_REVIEW_INTERVAL_DAYS=30
DATA_FRESHNESS_STALE_AFTER_DAYS=7

# ---- A3 alerting and Telegram delivery --------------------------------------
# "disabled" (default) | "fake" | "telegram".
# Disabled means a fresh deployment cannot message anyone by accident. A real send needs
# NOTIFICATION_TRANSPORT=telegram AND a bot token.
NOTIFICATION_TRANSPORT=disabled
# SERVER-SIDE ONLY. Never committed, never stored in the database, never returned by the API,
# never logged. The recipient chat is configured per workspace in Settings, not here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
# Public dashboard URL used for message deep links. Leave empty in local/dev: an unreachable
# link (localhost, a private IP) is omitted rather than sent.
PUBLIC_APP_URL=
NOTIFICATION_DISPATCH_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_MINUTES=1,5,15
NOTIFICATION_LEASE_SECONDS=120

# ---- A10 Meta Graph API (read-only) -----------------------------------------
# SERVER-SIDE ONLY, same boundary as TELEGRAM_BOT_TOKEN above: never committed, never stored in
# the database, never returned by the API, never logged. The API exposes a computed
# `token_configured` boolean, never the credential itself.
# Empty (the default) means every Meta call uses the fake provider. A real call needs BOTH this
# token AND a connection marked `production` — two independent conditions, so a misconfigured
# environment degrades to "no real call" rather than to a surprise one.
# Use a system user token scoped to read only; see docs/RUNBOOK_META_CONNECTION.md.
META_ACCESS_TOKEN=
# The Business Manager to read. Required for a system user token: Meta will not name the
# business behind one (verified live 2026-09-10 — `business` as a field is rejected outright,
# `businesses` as field or edge comes back empty), while reading the BM by id works.
# NOT a secret: a BM id is public in Business Settings, so unlike the token it may appear in
# logs and findings. Empty reports as a `false` capability with reason `not_configured`, never
# as a silent success.
META_BUSINESS_ID=
# Pinned deliberately. A floating version means Meta changes behaviour underneath a running
# deployment, so bump it as a decision with a release, never by accident.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
META_TIMEOUT_SECONDS=15

# ---- Schema upgrade at startup ---------------------------------------------
# Normally EMPTY. Set it to the alembic head revision this code is at (e.g. 0005_a5_extension)
# for one release on a host where `alembic upgrade head` cannot be run by hand, then unset it.
# A value that is not exactly this code's head is refused — it is a named target, not a switch.
MIGRATE_ON_START=

# ---- Rate limiting ---------------------------------------------------------
# Buckets are per API process. RATE_LIMIT_PROCESS_COUNT divides the allowance so the numbers
# below are what a caller actually gets.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_API_REQUESTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_PROCESS_COUNT=1
# Proxy hops between the client and the API. 0 = no proxy, and X-Forwarded-For is ignored
# because a client can set it itself. Behind the production nginx edge this is 1.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# ---- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---- Application -----------------------------------------------------------
APP_NAME="AdsOps Control Center"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://adsops:change-me@db:5432/adsops
POSTGRES_USER=adsops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adsops

# ---- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS ------------------------------------------------------------------
# Comma-separated allowlist. No wildcard.
CORS_ORIGINS=http://localhost:5173

# ---- First-run owner -------------------------------------------------------
# Used once, only while the database has no workspace.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_WORKSPACE_NAME=AdsOps

# ---- Readiness policy ------------------------------------------------------
READINESS_MANUAL_REVIEW_INTERVAL_DAYS=30
DATA_FRESHNESS_STALE_AFTER_DAYS=7

# ---- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

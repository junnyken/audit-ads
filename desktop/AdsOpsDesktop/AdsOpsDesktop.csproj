<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>3.7.0</Version>
    <AssemblyVersion>3.7.0.0</AssemblyVersion>
    <FileVersion>3.7.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <CodePage>65001</CodePage>
    <Description>AdsOps Desktop Pro v3.7.0 — ShardBrowser Open-Source Antidetect (:40325), 100% Automated Off-Screen CDP Page Auto-Post (Media Hash-Jitter) &amp; Auto-Share, Scheduled 14-Day Silent Page Nurture, 1-Click Cookie Harvest &amp; Custom Via Tags</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
    <EmbeddedResource Include="webui_bundle.zip" />
  </ItemGroup>
</Project>

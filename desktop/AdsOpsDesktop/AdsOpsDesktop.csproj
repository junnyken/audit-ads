<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <Description>AdsOps Desktop Pro v2.2 — Auto Cookie Bootstrap v2.9.3, 1-Click Cloud Token EAAB, Active Chrome Session Tracker, Telegram Bot Alerts &amp; Spend Summary</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
  </ItemGroup>
</Project>

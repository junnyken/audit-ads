<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <CodePage>65001</CodePage>
    <Description>AdsOps Desktop Pro v4.0.0 — Zero-Risk Google Ads 2 MCC + 5 Standalone 1:1 Silo Hub, Official Google Ads Script Sync &amp; Hardened Facebook Companion v2.10.3</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
    <EmbeddedResource Include="webui_bundle.zip" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <Description>AdsOps Desktop Pro v2.1 — Bulk Multi-Via Importer, Live 2FA TOTP &amp; Auto-Fill v2.9.2, Account Health &amp; Meta Token Hub, CSV Export, Ctrl+K Command Palette &amp; DPAPI Vault</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
  </ItemGroup>
</Project>

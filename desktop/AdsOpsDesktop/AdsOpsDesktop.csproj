<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>3.5.0</Version>
    <AssemblyVersion>3.5.0.0</AssemblyVersion>
    <FileVersion>3.5.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <CodePage>65001</CodePage>
    <Description>AdsOps Desktop Pro v3.5.0 — Unified 8-Tab shadcn/ui App Shell, Per-Via Environment Isolation (Window Size + Proxy Geo Lang/TZ + WebRTC Lock), Multi-Site Cookie Robot, 5 Care Presets &amp; Hybrid Page Nurture</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
    <EmbeddedResource Include="webui_bundle.zip" />
  </ItemGroup>
</Project>

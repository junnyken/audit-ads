<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>2.0.0</Version>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <Description>AdsOps Desktop Pro v2.0 — Modern Fluent Dark UI, Multi-Via Manager, Live 2FA TOTP, Automation Queue, Chrome v2.9.1 Provisioner, DPAPI Local Cookie/2FA Vault &amp; Cloud Sync</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
  </ItemGroup>
</Project>

    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AdsOpsDesktop</AssemblyName>
    <RootNamespace>AdsOpsDesktop</RootNamespace>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
    <Product>AdsOps Desktop Pro</Product>
    <Company>AdsOps</Company>
    <Description>AdsOps Desktop Pro v2.5.0 — Zero-Trust Bridge Token (127.0.0.1:17890), 5-Engine Antidetect Connector (AdsPower/Dolphin/Hidemyacc/Genlogin/GoLogin), RAM Farm Optimizer, DPAPI Offline Cache, Community Quotas &amp; Extension v2.9.7</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="extension_templates_v29.json" />
  </ItemGroup>
</Project>

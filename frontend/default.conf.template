# nginx configuration, rendered at container start.
#
# `${API_ORIGIN}` is substituted by the official nginx image's envsubst step.
# Domain-agnostic SEO: `/robots.txt` and `/sitemap.xml` dynamically use `$http_host`
# so switching to any custom domain later automatically updates sitemap & robots URLs.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (hardened per OWASP ASVS + Anti-AI Scraping)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-Robots-Tag "noai, noimageai" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.fbcdn.net https://graph.facebook.com https://*.facebook.com; font-src 'self' data:; frame-src https://challenges.cloudflare.com; connect-src 'self' ${API_ORIGIN} https://challenges.cloudflare.com http://127.0.0.1:17890 http://127.0.0.1:17891 http://127.0.0.1:17892 http://127.0.0.1:17893 http://127.0.0.1:17894 http://127.0.0.1:17895 http://localhost:17890 http://localhost:17891 http://localhost:17892 http://localhost:17893 http://localhost:17894 http://localhost:17895; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    if ($http_user_agent ~* "(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|CCBot|Google-Extended|Bytespider|Firecrawl|JinaBot|Diffbot|Cohere-ai|Scrapy|HTTrack|HeadlessChrome|PhantomJS)") {
        return 403;
    }

    server_tokens off;
    client_max_body_size 2m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Runtime API configuration (use expires so server-level OWASP add_header directives are inherited)
    location = /config.js {
        default_type application/javascript;
        expires -1;
        return 200 'window.__ADSOPS_API_BASE__ = "${API_ORIGIN}";';
    }

    # Dynamic domain-aware robots.txt (blocks AI crawlers/scrapers explicitly)
    location = /robots.txt {
        default_type text/plain;
        expires 1h;
        return 200 "User-agent: GPTBot\nDisallow: /\n\nUser-agent: OAI-SearchBot\nDisallow: /\n\nUser-agent: ChatGPT-User\nDisallow: /\n\nUser-agent: ClaudeBot\nDisallow: /\n\nUser-agent: PerplexityBot\nDisallow: /\n\nUser-agent: CCBot\nDisallow: /\n\nUser-agent: Google-Extended\nDisallow: /\n\nUser-agent: Bytespider\nDisallow: /\n\nUser-agent: FirecrawlAgent\nDisallow: /\n\nUser-agent: JinaBot\nDisallow: /\n\nUser-agent: *\nAllow: /\nAllow: /login\nDisallow: /assets/\nDisallow: /downloads/\nDisallow: /accounts\nDisallow: /retainers\nDisallow: /business-managers\nDisallow: /assets\nDisallow: /facebook-accounts\nDisallow: /pages\nDisallow: /alerts\nDisallow: /operations\nDisallow: /team\nDisallow: /settings\nDisallow: /audit-log\n\nSitemap: https://$http_host/sitemap.xml\n";
    }

    # Dynamic domain-aware sitemap.xml (automatically adapts when custom domain is changed)
    location = /sitemap.xml {
        default_type application/xml;
        expires 1h;
        return 200 '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n  <url>\n    <loc>https://$http_host/</loc>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>\n  <url>\n    <loc>https://$http_host/login</loc>\n    <changefreq>weekly</changefreq>\n    <priority>0.9</priority>\n  </url>\n</urlset>\n';
    }

    # SPA pages share the /assets namespace with Vite's static directory.
    # Match pages exactly; never fall back to HTML for missing JS/CSS files.
    location = /assets {
        expires -1;
        try_files /index.html =404;
    }
    location = /assets/emails {
        expires -1;
        try_files /index.html =404;
    }
    location = /assets/emails/ {
        expires -1;
        try_files /index.html =404;
    }

    # Note: Do not use add_header here so nginx preserves server-level OWASP headers.
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
